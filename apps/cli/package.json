{
  "name": "@omni/cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "omni": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "tsc -b",
    "clean": "tsc -b --clean && rm -rf dist"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "omni-core": "workspace:*",
    "omni-gateway": "workspace:*",
    "omni-providers": "workspace:*",
    "omni-swarm": "workspace:*",
    "omni-tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
