{
  "name": "omni-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "lint": "tsc -b",
    "clean": "tsc -b --clean && rm -rf dist"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.3.1",
    "archiver": "^7.0.1",
    "crypto-js": "^4.2.0",
    "ws": "^8.17.0",
    "uuid": "^9.0.1",
    "omni-core": "workspace:*",
    "omni-swarm": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.10",
    "@types/archiver": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "@types/node": "^20.14.0"
  }
}
