{
  "name": "omni-invest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -b",
    "clean": "tsc -b --clean && rm -rf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.4.5"
  }
}
